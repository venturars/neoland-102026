{
  "name": "first-app",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/browser/**/*.js\" \"src/clients/rest/**/*.js\" \"src/clients/electron/**/*.js\" \"eslint.config.js\"",
    "lint": "eslint .",
    "jupyter": "test -x .venv/bin/jupyter-notebook || (test -d .venv || python3 -m venv .venv && .venv/bin/pip install notebook==7.6.3) && .venv/bin/jupyter notebook src/clients/jupyter",
    "db": "node src/db/server.js",
    "browser": "open -na \"Google Chrome\" --args --user-data-dir=/tmp/first-app-chrome --allow-file-access-from-files \"file://$(pwd)/src/clients/browser/index.html\"",
    "api": "node src/clients/rest/server.js",
    "bruno": "cd src/clients/rest/bruno && bru run 01-sql-online -r",
    "electron": "electron src/clients/electron/main.js"
  },
  "keywords": [],
  "author": "Meghan Martin",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@colors/colors": "1.6.1",
    "cli-table3": "0.6.5",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@usebruno/cli": "4.3.0",
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
