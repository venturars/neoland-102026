{
  "name": "first-app",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/browser/**/*.js\" \"src/clients/rest/**/*.js\" \"src/clients/electron/**/*.js\" \"src/clients/nest/**/*.js\" \"eslint.config.js\"",
    "lint": "eslint .",
    "jupyter": "test -x .venv/bin/jupyter-notebook || (test -d .venv || python3 -m venv .venv && .venv/bin/pip install notebook==7.6.3) && .venv/bin/jupyter notebook src/clients/jupyter",
    "db": "node src/db/server.js",
    "browser": "open -na \"Google Chrome\" --args --user-data-dir=/tmp/first-app-chrome --allow-file-access-from-files \"file://$(pwd)/src/clients/browser/index.html\"",
    "api": "node src/clients/rest/server.js",
    "electron": "electron src/clients/electron/main.js",
    "nest": "rm -rf dist && babel src -d dist --config-file ./babel.config.json && node dist/clients/nest/main.js"
  },
  "keywords": [],
  "author": "Meghan Martin",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@colors/colors": "1.6.1",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "cli-table3": "0.6.5",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-env": "8.0.7",
    "@eslint/js": "10.0.1",
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
