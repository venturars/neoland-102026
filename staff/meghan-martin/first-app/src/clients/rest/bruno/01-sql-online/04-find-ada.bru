meta {
  name: find-ada
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: none
}

tests {
  test("Estado 200", function () { expect(res.getStatus()).to.equal(200); });
  test("La misma Ada", function () {
    const user = res.getBody();
    expect(user.id).to.equal(Number(bru.getVar("userId")));
    expect(user.name).to.equal("Ada");
    expect(user.email).to.equal("ada@example.com");
    expect(user).to.have.all.keys("id", "name", "email", "createdAt", "updatedAt");
  });
}
