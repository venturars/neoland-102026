meta {
  name: delete-missing
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/users/{{missingId}}
  body: none
  auth: none
}

tests {
  test("Estado 404", function () { expect(res.getStatus()).to.equal(404); });
  test("Mensaje exacto", function () { expect(res.getBody()).to.deep.equal({ error: "User not found" }); });
}
