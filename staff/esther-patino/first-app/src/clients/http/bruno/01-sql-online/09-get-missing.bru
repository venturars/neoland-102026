meta {
  name: get-missing
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/users/{{missingId}}
  body: none
  auth: none
}

tests {
  test("Estado 404", function () { expect(res.getStatus()).to.equal(404); });
  test("Mensaje exacto", function () { expect(res.getBody()).to.deep.equal({ message: "User not found" }); });
}
