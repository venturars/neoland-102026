meta {
  name: patch-missing
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/users/{{missingId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Nobody"
  }
}

tests {
  test("Estado 404", function () { expect(res.getStatus()).to.equal(404); });
  test("Mensaje was not found", function () { expect(res.getBody().message).to.match(/was not found$/); });
}
