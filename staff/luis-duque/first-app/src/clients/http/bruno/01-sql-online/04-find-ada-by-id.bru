meta {
  name: find-ada-by-id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: none
}

tests {
  test("Estado 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Mismos datos", function () { expect(res.getBody().id).to.equal(Number(bru.getVar("userId"))); expect(res.getBody().name).to.equal("Ada"); expect(res.getBody().email).to.equal("ada@example.com"); });
}
