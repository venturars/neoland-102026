{
  "name": "first-app",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "jupyter": "sh scripts/jupyter.sh",
    "server": "node src/db/server.js",
    "browser": "open -na \"Brave Browser\" --args --user-data-dir=/tmp/first-app-brave --allow-file-access-from-files \"file://$(pwd)/src/clients/browser/index.html\"",
    "http": "node src/clients/http/app.js",
    "bruno": "sh -c 'cd src/clients/http/bruno && ../../../../node_modules/.bin/bru run 01-sql-online -r'",
    "chrome": "node src/clients/chrome/server.js",
    "electron": "electron src/clients/electron/main.js",
    "vscode": "code --extensionDevelopmentPath=\"$(pwd)/src/clients/vscode\" \"$(pwd)\"",
    "nest": "rm -rf dist && babel src -d dist --config-file ./babel.config.json && node dist/clients/nest/main.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/http/**/*.js\" \"src/clients/electron/**/*.js\" \"src/clients/chrome/**/*.js\" \"src/clients/vscode/**/*.js\" \"src/clients/nest/**/*.js\"",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "Ventura Rodriguez",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@colors/colors": "1.6.1",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "cli-table3": "0.6.5",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "openai": "7.39.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-env": "8.0.7",
    "@eslint/js": "10.0.1",
    "@usebruno/cli": "4.3.0",
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}