meta {
  name: create invalid email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bad Email",
    "email": "not-an-email"
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("message", function () {
    expect(res.getBody().message).to.equal("Email is invalid");
  });
}
