meta {
  name: create Ada for duplicate test
  type: http
  seq: 3
}

script:pre-request {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const listRes = await axios.get(baseUrl + "/users");
  const users = listRes.data;
  for (let index = 0; index < users.length; index = index + 1) {
    const user = users[index];
    if (user.email === "ada@example.com") {
      await axios.delete(baseUrl + "/users/" + user.id);
    }
  }
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ada",
    "email": "ada@example.com"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("validationUserId", String(body.id));
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
