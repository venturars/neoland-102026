meta {
  name: list users
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("includes Ada", function () {
    const users = res.getBody();
    const ada = users.find(function (user) {
      return user.email === "ada@example.com";
    });
    expect(ada).to.not.equal(undefined);
    expect(ada.name).to.equal("Ada");
  });
}
