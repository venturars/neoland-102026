{
  "manifest_version": 3,
  "name": "first-app usuarios",
  "version": "1.0.0",
  "description": "Gestiona los usuarios de first-app a través de su API local.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "first-app usuarios"
  },
  "host_permissions": ["http://127.0.0.1:3001/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src http://127.0.0.1:3001"
  }
}
