{
  "name": "data-base",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/logic/**/*.js\" \"src/queries/**/*.js\" \"src/db/**/*.js\" \"src/clients/browser/**/*.{js,html,css}\" \"src/clients/rest/**/*.js\" \"src/clients/electron/**/*.{js,html,css}\" \"src/clients/chrome/**/*.{js,html,css,json}\" eslint.config.js",
    "lint": "eslint .",
    "browser": "start \"\" chrome --user-data-dir=\"%TEMP%\\first-app-chrome\" --allow-file-access-from-files --no-first-run --no-default-browser-check \"%CD%\\src\\clients\\browser\\index.html\"",
    "db": "node --no-warnings src/db/server.js",
    "api": "node --no-warnings src/clients/rest/server.js",
    "electron": "electron src/clients/electron/main.js",
    "chrome": "node --no-warnings src/clients/chrome/server.js"
  },
  "dependencies": {
    "@colors/colors": "1.6.1",
    "cli-table3": "0.6.5",
    "express": "5.3.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10"
  }
}
