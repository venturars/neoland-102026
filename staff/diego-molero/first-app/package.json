{
  "name": "diego-first-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Gestión de usuarios y clasificador local con SQLite.",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "db:init": "node --input-type=module < clients/terminal/create-users-table.txt",
    "create-user": "node --input-type=module < clients/terminal/create-user.txt",
    "update-user": "node --input-type=module < clients/terminal/update-user.txt",
    "delete-user": "node --input-type=module < clients/terminal/delete-user.txt",
    "list-users": "node --input-type=module < clients/terminal/list-users.txt",
    "find-user-by-email": "node --input-type=module < clients/terminal/find-user-by-email.txt",
    "find-user-by-id": "node --input-type=module < clients/terminal/find-user-by-id.txt",
    "classify": "node --input-type=module < clients/terminal/users-gender-count.txt"
  }
}
