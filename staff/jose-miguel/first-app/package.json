{
  "name": "first-app",
  "version": "1.0.0",
  "description": "Gestión de usuarios: logic, queries, db y clients",
  "type": "module",
  "main": "src/logic/create-user.js",
  "scripts": {
    "jupyter": "node scripts/start-jupyter.js",
    "server": "node src/db/server.js",
    "browser": "node scripts/start-browser.js",
    "electron": "electron src/clients/electron/main.js",
    "http": "node src/clients/http/app.js",
    "bruno": "node scripts/run-bruno.js",
    "chrome": "node src/clients/chrome/server.js",
    "nest": "node scripts/run-nest.js",
    "node-http": "node src/clients/node-http/server.js",
    "jupyter-node-http": "node scripts/start-jupyter-node-http.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/http/**/*.js\" \"src/clients/electron/**/*.js\" \"src/clients/chrome/**/*.js\" \"src/clients/vscode/**/*.js\" \"src/clients/nest/**/*.js\" \"src/clients/node-http/**/*.js\" \"scripts/**/*.js\"",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "cli-table3": "0.6.5",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "openai": "^7.39.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-env": "8.0.7",
    "@eslint/js": "10.0.1",
    "@usebruno/cli": "4.3.0",
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
