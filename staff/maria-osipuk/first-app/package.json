{
  "name": "first-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "node -e \"const agent = process.env.npm_config_user_agent || ''; if (!agent.startsWith('pnpm/')) { console.error('Use pnpm. npm and npx are not allowed in this project.'); process.exit(1); }\"",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1",
    "start": "node src/db/server.js",
    "http": "node src/clients/http/app.js",
    "electron": "electron src/clients/electron/main.js",
    "web": "open -na \"Google Chrome\" --args --user-data-dir=/tmp/first-app-chrome --allow-file-access-from-files \"file://$(pwd)/src/clients/web/index.html\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "dependencies": {
    "express": "5.3.0",
    "openai": "^7.40.0"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
