{
  "name": "first-app",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "server": "node src/db/server.js",
    "web": "open -na \"Brave Browser\" --args --user-data-dir=/tmp/first-app-brave --allow-file-access-from-files \"file://$(pwd)/src/clients/web/index.html\"",
    "http": "node src/clients/http/server.js",
    "jupyter": "sh scripts/jupyter.sh",
    "format": "prettier --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/**/*.js\"",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "sergio cortes",
  "license": "MIT",
  "dependencies": {
    "@colors/colors": "1.6.1",
    "cli-table3": "0.6.5",
    "express": "5.3.0",
    "openai": "^7.39.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
