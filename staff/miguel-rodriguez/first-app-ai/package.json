{
  "name": "first-app-ai",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "openai": "7.39.0"
  },
  "scripts": {
    "jupyter": "node scripts/jupyter.js",
    "format": "prettier --no-config --no-editorconfig --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/jupyter/**/*.js\" \"src/clients/http/**/*.js\" \"src/clients/web/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"",
    "lint": "eslint .",
    "web": "node src/clients/http/start-server.js",
    "test:web": "node --test tests/web-client.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cli-table3": "0.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
