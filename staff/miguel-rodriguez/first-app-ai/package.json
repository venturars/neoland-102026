{
  "name": "first-app-ai",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "openai": "7.39.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "scripts": {
    "jupyter": "node scripts/jupyter.js",
    "format": "prettier --no-config --no-editorconfig --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/jupyter/**/*.js\" \"src/clients/web/**/*.js\" \"src/clients/http/**/*.js\" \"src/clients/vscode/**/*.js\" \"src/clients/vscode/**/*.cjs\" \"src/clients/electron/**/*.js\" \"src/clients/electron/**/*.cjs\" \"src/clients/chrome/**/*.js\" \"src/clients/nest/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"",
    "lint": "eslint .",
    "server": "node src/db/server.js",
    "web": "node scripts/web.js",
    "http": "node src/clients/http/app.js",
    "electron": "electron src/clients/electron/main.js",
    "chrome": "node src/clients/chrome/server.js",
    "nest": "node src/clients/nest/app.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cli-table3": "0.6.5",
    "electron": "45.2.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
