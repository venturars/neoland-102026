meta {
  name: patch-empty-name
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/users/{{adaId}}
  body: json
  auth: none
}

body:json {
  {
    "name": " "
  }
}

tests {
  test("Rechazo: Name is empty", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.deep.equal({ message: "Name is empty" });
  });
}
