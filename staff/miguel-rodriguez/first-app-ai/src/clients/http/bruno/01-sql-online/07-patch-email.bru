meta {
  name: patch-email
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/users/{{adaId}}
  body: json
  auth: none
}

body:json {
  {
    "email": "ada.lovelace@example.com"
  }
}

tests {
  test("Modificar solo email", function () {
    expect(res.getStatus()).to.equal(200);
    const before = JSON.parse(bru.getVar("ada"));
    const user = res.getBody();
    expect(user).to.have.all.keys("id", "name", "email", "createdAt", "updatedAt");
    expect(user.id).to.equal(before.id);
    expect(user.createdAt).to.equal(before.createdAt);
    expect(user.updatedAt).to.be.a("string");
    expect(user.email).to.equal("ada.lovelace@example.com");
    expect(user.name).to.equal(before.name);
    const saved = JSON.stringify(user);
    bru.setVar("ada", saved);
  });
}
