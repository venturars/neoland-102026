meta {
  name: patch-used-email
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/users/{{adaId}}
  body: json
  auth: none
}

body:json {
  {
    "email": "grace@example.com"
  }
}

tests {
  test("Rechazo: Email is already used", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody()).to.deep.equal({ message: "Email is already used" });
  });
}
