meta {
  name: create-sql-offline
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Offline",
    "email": "offline@example.com"
  }
}

tests {
  test("Fallo de datos: Could not create the user", function () {
    expect(res.getStatus()).to.equal(500);
    expect(res.getBody()).to.deep.equal({ message: "Could not create the user" });
  });
}
