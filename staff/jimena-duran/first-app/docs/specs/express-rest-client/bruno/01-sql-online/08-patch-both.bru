meta {
  name: patch-both
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Ada",
    "email": "ada@example.com"
  }
}

tests {
  test("Estado 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Cambia ambos campos", function () { expect(res.getBody().name).to.equal("Ada"); expect(res.getBody().email).to.equal("ada@example.com"); });
}
