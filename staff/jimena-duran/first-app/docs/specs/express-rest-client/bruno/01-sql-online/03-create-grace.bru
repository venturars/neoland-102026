meta {
  name: create-grace
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Grace",
    "email": "grace@example.com"
  }
}

script:post-response {
  bru.setVar("otherId", res.getBody().id);
  bru.setVar("otherUser", JSON.stringify(res.getBody()));
}

tests {
  test("Estado 201", function () { expect(res.getStatus()).to.equal(201); });
  test("Campos del usuario", function () { expect(res.getBody()).to.have.all.keys("id", "name", "email", "createdAt", "updatedAt"); });
}
