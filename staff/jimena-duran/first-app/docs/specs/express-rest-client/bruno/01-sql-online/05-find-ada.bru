meta {
  name: find-ada
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: none
}

tests {
  test("Estado 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Campos del usuario", function () { expect(res.getBody()).to.have.all.keys("id", "name", "email", "createdAt", "updatedAt"); });
  test("ID original", function () { expect(res.getBody().id).to.equal(Number(bru.getVar("userId"))); });
}
