meta {
  name: create-invalid-email
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Invalid",
    "email": "invalid"
  }
}

tests {
  test("Estado 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Mensaje exacto", function () { expect(res.getBody()).to.deep.equal({ message: "Email is invalid" }); });
}
