{
  "name": "first-app",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write \"src/db/**/*.js\" \"src/queries/**/*.js\" \"src/logic/**/*.js\" \"src/clients/http/**/*.js\" \"src/clients/electron/**/*.js\" \"src/clients/chrome/**/*.js\" \"src/clients/vscode/**/*.js\" \"src/clients/nest/**/*.js\"",
    "lint": "eslint .",
    "server": "node src/db/server.js",
    "browser": "powershell -NoProfile -Command \"$page = [uri](Resolve-Path 'src/clients/browser/index.html').Path; $browserProfile = Join-Path $env:TEMP 'first-app-chrome'; & 'C:/Program Files/Google/Chrome/Application/chrome.exe' ('--user-data-dir=' + $browserProfile) '--allow-file-access-from-files' $page.AbsoluteUri\"",
    "http": "node src/clients/http/app.js",
    "electron": "electron src/clients/electron/main.js",
    "chrome": "node src/clients/chrome/server.js",
    "vscode": "powershell -NoProfile -Command \"$appPath = (Get-Location).Path; $extensionPath = Join-Path $appPath 'src/clients/vscode'; code ('--extensionDevelopmentPath=' + $extensionPath) $appPath\"",
    "nest": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && babel src --out-dir dist --config-file ./babel.config.json && node dist/clients/nest/main.js"
  },
  "keywords": [],
  "author": "Jimena Durán",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "express": "5.3.0",
    "fastify": "5.12.8",
    "openai": "7.39.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "electron": "45.2.2",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-env": "8.0.7"
  }
}
