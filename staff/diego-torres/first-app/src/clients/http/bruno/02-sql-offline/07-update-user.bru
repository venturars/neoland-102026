meta {
  name: update-user
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/users/{{missingId}}
  body: json
  auth: none
}

body:json {
  { "name": "Nadie" }
}

tests {
  test("Estado 500", function () {
    expect(res.getStatus()).to.equal(500);
  });

  test("Mensaje Could not update the user", function () {
    expect(res.getBody().message).to.equal("Could not update the user");
  });
}
