meta {
  name: find-by-id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/users/{{missingId}}
  body: none
  auth: none
}

tests {
  test("Estado 500", function () {
    expect(res.getStatus()).to.equal(500);
  });

  test("Mensaje Could not find the user", function () {
    expect(res.getBody().message).to.equal("Could not find the user");
  });
}
