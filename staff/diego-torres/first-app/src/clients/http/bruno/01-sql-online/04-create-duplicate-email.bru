meta {
  name: create-duplicate-email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  { "name": "Otra Ada", "email": "{{adaEmail}}" }
}

tests {
  test("Estado 409", function () {
    expect(res.getStatus()).to.equal(409);
  });

  test("Mensaje Email is already used", function () {
    expect(res.getBody().message).to.equal("Email is already used");
  });
}
