meta {
  name: create-empty-name
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  { "name": "   ", "email": "vacio@example.com" }
}

tests {
  test("Estado 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("Mensaje Name is empty", function () {
    expect(res.getBody().message).to.equal("Name is empty");
  });
}
