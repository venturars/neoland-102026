meta {
  name: update-empty-name
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: none
}

body:json {
  { "name": "   " }
}

tests {
  test("Estado 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("Mensaje Name is empty", function () {
    expect(res.getBody().message).to.equal("Name is empty");
  });
}
