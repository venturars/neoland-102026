meta {
  name: create-grace
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  { "name": "Grace", "email": "{{graceEmail}}" }
}

script:post-response {
  bru.setVar("graceId", res.getBody().id);
}

tests {
  test("Estado 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
